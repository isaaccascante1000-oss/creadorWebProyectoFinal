# Configuración de Claves y Webhooks para CanvasAI
VITE_GEMINI_API_KEY=tu_clave_de_gemini_aqui
VITE_N8N_REGISTER_WEBHOOK_URL=https://n8n.canvasai.fwd/webhook/user-registration
VITE_N8N_PROJECT_EXPORT_WEBHOOK_URL=https://n8n.canvasai.fwd/webhook/project-export

# Proveedor Secundario de IA (Fallback) si Gemini falla o n8n congestiona
VITE_MISTRAL_API_KEY=""

# Backend OAuth. Nunca expongas CLIENT_SECRET en variables VITE_*.
VITE_AUTH_API_URL=http://localhost:3000
VITE_AUTH_CALLBACK_URL=http://localhost:5173/login
